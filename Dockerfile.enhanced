# syntax=docker/dockerfile:1
# =============================================================================
# Enhanced Developer Container - Batteries Included
# =============================================================================
#
# Extends the base image with modern CLI tools for instant startup.
# Build with: ./scripts/build-enhanced.sh
# Use with:   ./scripts/run.sh --use-enhanced
#
# Adds to base image:
#   - Starship prompt (fast, customizable)
#   - eza (modern ls), bat (cat with highlighting)
#   - delta (better git diff), zoxide (smart cd)
#   - btop (system monitor), lazygit (git TUI)
#   - tmux (configured), neovim + kickstart
#   - direnv (per-directory environments)
#
# Version overrides (use --build-arg):
#   EZA_VERSION, DELTA_VERSION, ZOXIDE_VERSION, LAZYGIT_VERSION
#
FROM grandcamel/claude-devcontainer:latest

LABEL maintainer="jasonkrue@gmail.com"
LABEL description="Enhanced developer container with pre-installed modern CLI tools"
LABEL version="1.0.0"

# =============================================================================
# Enhanced Tools (requires root)
# =============================================================================
USER root

# Additional apt packages for enhanced experience
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    tmux \
    neovim \
    direnv \
    btop \
    bat \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/batcat /usr/local/bin/bat

# =============================================================================
# Enhanced CLI Tools (binary releases for faster builds)
# =============================================================================
ARG EZA_VERSION=0.20.13
ARG DELTA_VERSION=0.18.2
ARG ZOXIDE_VERSION=0.9.6
ARG LAZYGIT_VERSION=0.44.1

# Starship prompt
RUN curl -sS https://starship.rs/install.sh | sh -s -- -y

# eza (modern ls)
RUN curl -sLo /tmp/eza.tar.gz \
    "https://github.com/eza-community/eza/releases/download/v${EZA_VERSION}/eza_x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/eza.tar.gz -C /usr/local/bin \
    && chmod +x /usr/local/bin/eza \
    && rm /tmp/eza.tar.gz

# delta (better git diff)
RUN curl -sLo /tmp/delta.tar.gz \
    "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/delta-${DELTA_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && tar -xzf /tmp/delta.tar.gz -C /tmp \
    && mv /tmp/delta-${DELTA_VERSION}-x86_64-unknown-linux-gnu/delta /usr/local/bin/ \
    && chmod +x /usr/local/bin/delta \
    && rm -rf /tmp/delta*

# zoxide (smart cd)
RUN curl -sLo /tmp/zoxide.tar.gz \
    "https://github.com/ajeetdsouza/zoxide/releases/download/v${ZOXIDE_VERSION}/zoxide-${ZOXIDE_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
    && tar -xzf /tmp/zoxide.tar.gz -C /usr/local/bin zoxide \
    && chmod +x /usr/local/bin/zoxide \
    && rm /tmp/zoxide.tar.gz

# lazygit
RUN curl -sLo /tmp/lazygit.tar.gz \
    "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz" \
    && tar -xzf /tmp/lazygit.tar.gz -C /usr/local/bin lazygit \
    && chmod +x /usr/local/bin/lazygit \
    && rm /tmp/lazygit.tar.gz

# =============================================================================
# Copy Enhanced Configurations
# =============================================================================
COPY config/starship.toml /home/devuser/.config/starship.toml
COPY config/tmux.conf /home/devuser/.tmux.conf
COPY config/bashrc-enhanced /home/devuser/.bashrc-enhanced

RUN mkdir -p /home/devuser/.config \
    && chown -R 1000:1000 /home/devuser/.config /home/devuser/.tmux.conf /home/devuser/.bashrc-enhanced

# =============================================================================
# User Configuration
# =============================================================================
USER devuser
WORKDIR /home/devuser

# Neovim Kickstart
RUN git clone --depth 1 https://github.com/nvim-lua/kickstart.nvim.git /home/devuser/.config/nvim

# Git delta config
RUN git config --global core.pager delta \
    && git config --global interactive.diffFilter "delta --color-only" \
    && git config --global delta.navigate true \
    && git config --global delta.light false \
    && git config --global delta.line-numbers true \
    && git config --global delta.side-by-side false \
    && git config --global merge.conflictStyle diff3 \
    && git config --global diff.colorMoved default

# Append enhanced shell config to bashrc
RUN cat ~/.bashrc-enhanced >> ~/.bashrc && rm ~/.bashrc-enhanced

# =============================================================================
# Working Directory & Entrypoint
# =============================================================================
WORKDIR /workspace

ENTRYPOINT ["/bin/bash"]
CMD ["-l"]
